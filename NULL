-- ──────────────── ONLINE TIME (anti date-spoof) ─

local function getOnlineTimestamp()
    -- Fetches real server time from Cloudflare edge.
    -- Changing the device clock has NO effect on this value.
    local ok, result = pcall(function()
        return gg.makeRequest("https://1.1.1.1/cdn-cgi/trace")
    end)
    if not ok or type(result) ~= "table" or not result.content then
        return nil
    end
    local ts = result.content:match("ts=(%d+%.?%d*)")
    return ts and math.floor(tonumber(ts)) or nil
end

local function dateToUnix(dateStr)
    -- Converts "YYYY-MM-DD" → Unix timestamp (start of next day, so full expiry day is usable)
    local y, m, d = dateStr:match("(%d%d%d%d)-(%d%d)-(%d%d)")
    if not y then return nil end
    y, m, d = tonumber(y), tonumber(m), tonumber(d)
    local dim = {31,28,31,30,31,30,31,31,30,31,30,31}
    if (y%4==0 and y%100~=0) or (y%400==0) then dim[2]=29 end
    local days = 0
    for yr = 1970, y-1 do
        days = days + (((yr%4==0 and yr%100~=0) or (yr%400==0)) and 366 or 365)
    end
    for mo = 1, m-1 do days = days + dim[mo] end
    days = days + d          -- include the full expiry day itself
    return days * 86400
end

-- ──────────────── EXPIRY CHECK ─────────────────

local function checkExpiry()
    gg.toast("•  verifying expiry date...")

    local ok, res = pcall(function()
        return gg.makeRequest(EXPIRE_URL)
    end)
    if not ok or type(res) ~= "table" or not res.content then
        gg.alert("✕  Cannot reach expiry server.\nCheck your internet connection.")
        os.exit()
    end

    local expireDate = res.content:match("^%s*(.-)%s*$")
    local expireTs   = dateToUnix(expireDate)
    if not expireTs then
        gg.alert("✕  Invalid expiry data.\nContact admin.")
        os.exit()
    end

    local onlineTs = getOnlineTimestamp()
    if not onlineTs then
        -- If we can't reach the time server we refuse to run.
        -- This prevents offline bypass via device clock tricks.
        gg.alert(
            "✕  Cannot verify online time.\n\n" ..
            "Make sure you are connected\n" ..
            "to the internet and try again."
        )
        os.exit()
    end

    if onlineTs >= expireTs then
        gg.alert(
            "⛔  SCRIPT EXPIRED\n" ..
            "━━━━━━━━━━━━━━━━━━━━━\n\n" ..
            "Expired on  :  " .. expireDate .. "\n\n" ..
            "Contact admin to renew access."
        )
        os.exit()
    end

    local daysLeft = math.floor((expireTs - onlineTs) / 86400)
    gg.toast("✓  Valid — expires in " .. daysLeft .. " day(s)")
    gg.sleep(700)
end

-- ──────────────── PASSWORD CHECK ───────────────

local function checkPassword()
    local MAX_ATTEMPTS = 3
    for attempt = 1, MAX_ATTEMPTS do
        local input = gg.prompt(
            {"🔐  Enter Password:"},
            {""},
            {"text"}
        )
        if input == nil then
            gg.toast("✕  Cancelled. Exiting.")
            os.exit()
        end
        local pass = tostring(input[1] or "")
        if pass == ADMIN_PASSWORD then
            USER_ROLE = "admin"
            gg.toast("✓  Welcome, Admin!")
            gg.sleep(500)
            return
        elseif pass == VIP_PASSWORD then
            USER_ROLE = "vip"
            gg.toast("✓  Welcome, VIP User!")
            gg.sleep(500)
            return
        else
            local left = MAX_ATTEMPTS - attempt
            if left > 0 then
                gg.alert(
                    "✕  Wrong password!\n" ..
                    tostring(left) .. " attempt(s) remaining."
                )
            else
                gg.alert("⛔  Too many failed attempts.\nAccess denied.")
                os.exit()
            end
        end
    end
end

