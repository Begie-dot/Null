        gg.refineNumber("1", gg.TYPE_FLOAT, false, gg.SIGN_EQUAL, 0, -1, 0)
        largeHP_revert = gg.getResults(5000, nil, nil, nil, nil, nil, nil, nil, nil)
        for _, v in ipairs(largeHP_revert) do
            v.value = "1"
        end
        gg.editAll("3", gg.TYPE_FLOAT)
        local t = gg.getResults(5000, nil, nil, nil, nil, nil, nil, nil, nil)
        gg.addListItems(t)
        t = nil
        gg.toast("Large HP Lord Turtle Buff On")
