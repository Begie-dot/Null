local function rd_isValid(ptr)
    if not ptr or ptr == 0 or ptr < 0x10000 then return false end
    local ok, r = pcall(gg.getValues, {{address=ptr, flags=4}})
    return ok and r ~= nil and #r > 0
end

local function rd_decodeADRP(instrAddr)
    local raw = rd_readI32(instrAddr)
    if raw == 0 then return 0 end
    if (raw & 0x9F000000) ~= 0x90000000 then return 0 end
    local immlo = (raw >> 29) & 0x3
    local immhi = (raw >> 5) & 0x7FFFF
    local imm21 = (immhi << 2) | immlo
    if (imm21 & 0x100000) ~= 0 then imm21 = imm21 - 0x200000 end
    return (instrAddr & ~0xFFF) + (imm21 << 12)
end

local function rd_readStr(strPtr)
    if not rd_isValid(strPtr) then return "" end
    local len = rd_readI32(strPtr + RD_STR_LEN)
    if len <= 0 then return "" end
    if len > 64 then len = 64 end
    local t = {}
    for i = 0, len - 1 do
        local c = rd_readU16(strPtr + RD_STR_CHARS + i * 2) & 0xFFFF
        if c == 0 then break end
        if c >= 32 and c <= 126 then
            t[#t+1] = string.char(c)
        else
            t[#t+1] = "?"
        end
    end
    return table.concat(t)
end

local function rd_safeStr(val)
    if not val or val == "" then return "Unknown" end
    return val
end

local function rd_safeNum(val)
    if not val then return "0" end
    return tostring(val)
end

local function rd_buildTeamText(team, teamName, teamEmoji, totalHumans, totalBots, startIndex)
    local lines = {}
    totalHumans = totalHumans or 0
    totalBots   = totalBots   or 0
    startIndex  = startIndex  or 1
    teamName    = teamName    or "TEAM"
    teamEmoji   = teamEmoji   or ""
    local teamHumans, teamBots = 0, 0
    for _, p in ipairs(team) do
        if p.isBot then teamBots = teamBots + 1 else teamHumans = teamHumans + 1 end
    end

    lines[#lines+1] = "◈ ʟᴏʙʙʏ  ▸ ʜᴜᴍᴀɴ: "..tostring(totalHumans).."  ◆ ʙᴏᴛ: "..tostring(totalBots)
    lines[#lines+1] = "━━━━━━━━━━━━━━━━━━━━━"
    lines[#lines+1] = "◤ "..teamName.." ◢"
    lines[#lines+1] = "▸ ʜᴜᴍᴀɴ: "..tostring(teamHumans).."  ◆ ʙᴏᴛ: "..tostring(teamBots)
    lines[#lines+1] = "━━━━━━━━━━━━━━━━━━━━━"
    lines[#lines+1] = ""

    if #team == 0 then
        lines[#lines+1] = "  ✕  (ɴᴏ ᴘʟᴀʏᴇʀs ꜰᴏᴜɴᴅ)"
    end

    for i, p in ipairs(team) do
        local num   = tostring(startIndex + i - 1)
        local ptype = p.isBot and "◆ ʙᴏᴛ" or "◇ ʜᴜᴍᴀɴ"
        lines[#lines+1] = "▶ "..num..". ɴᴀᴍᴇ   : "..rd_safeStr(p.name).."  "..ptype
        lines[#lines+1] = "  ◈ ʜᴇʀᴏ    : "..rd_heroToString(p.heroId)
        lines[#lines+1] = "  ◈ sᴘᴇʟʟ   : "..rd_spellToString(p.spellId)
        lines[#lines+1] = "  ◈ ʀᴀɴᴋ    : "..rd_safeStr(p.rank)
        lines[#lines+1] = "  ◈ ᴇʟᴏ     : "..rd_safeNum(p.elo)
        lines[#lines+1] = "━━━━━━━━━━━━━━━━━━━━━"
        lines[#lines+1] = ""
    end

    return table.concat(lines, "\n")
end

local function roomInfo()
    loading("room info")

    local function fetchRoomData()
        gg.toast("•  reading room data...")

        local libbase = 0
        local ranges = gg.getRangesList("libcsharp.so")
        if not ranges or #ranges == 0 then
            return nil, nil, "✕  ʀᴏᴏᴍ ᴅᴀᴛᴀ ɴᴏᴛ ꜰᴏᴜɴᴅ"
        end
        for _, r in ipairs(ranges) do
            if r.state == "Xa" then libbase = r.start break end
        end
        if libbase == 0 then
            return nil, nil, "✕  ʀᴏᴏᴍ ᴅᴀᴛᴀ ɴᴏᴛ ꜰᴏᴜɴᴅ"
        end

        local funcAddr   = libbase + RD_FUNC_OFFSET
        local staticPage = rd_decodeADRP(funcAddr + 0x10)
        if staticPage == 0 then
            return nil, nil, "✕  ʀᴏᴏᴍ ᴅᴀᴛᴀ ʀᴇᴀᴅɪɴɢ ꜰᴀɪʟᴇᴅ"
        end

        local obj  = rd_readPtr(staticPage + RD_STATIC_OBJ_OFF)
        local mid  = rd_isValid(obj) and rd_readPtr(obj + RD_MID_OFF) or 0
        local dict = rd_isValid(mid) and rd_readPtr(mid + RD_DICT_OFF) or 0
        if not rd_isValid(dict) then
            return nil, nil, "✕  ʀᴜɴ ᴀᴛ ʜᴇʀᴏ sᴇʟᴇᴄᴛ sᴄʀᴇᴇɴ"
        end

        local battleId   = rd_readPtr(mid + RD_BATTLEID_OFF)
        local entriesPtr = rd_readPtr(dict + RD_DICT_ENTRIES)
        local entryCount = rd_readI32(dict + RD_DICT_COUNT)
        local playerList = 0

        if rd_isValid(entriesPtr) and entryCount > 0 then
            for i = 0, entryCount - 1 do
                local entryBase = entriesPtr + RD_ARRAY_DATA + i * RD_ENTRY_SIZE
                local hashCode  = rd_readI32(entryBase)
                if hashCode >= 0 then
                    local key = rd_readPtr(entryBase + RD_ENTRY_KEY)
                    if key == battleId and battleId ~= 0 then
                        playerList = rd_readPtr(entryBase + RD_ENTRY_VALUE)
                        break
                    end
                end
            end
            if not rd_isValid(playerList) then
                for i = 0, entryCount - 1 do
                    local entryBase = entriesPtr + RD_ARRAY_DATA + i * RD_ENTRY_SIZE
                    local hashCode  = rd_readI32(entryBase)
                    if hashCode >= 0 then
                        local candidate = rd_readPtr(entryBase + RD_ENTRY_VALUE)
                        if rd_isValid(candidate) then
                            local cnt = rd_readI32(candidate + RD_LIST_SIZE)
                            if cnt >= 1 and cnt <= 10 then
                                local items = rd_readPtr(candidate + RD_LIST_ITEMS)
                                if rd_isValid(items) then
                                    local first = rd_readPtr(items + RD_ARRAY_DATA)
                                    if rd_isValid(first) then
                                        local heroId = rd_readI32(first + RD_HEROID)
                                        local camp   = rd_readI32(first + RD_CAMP)
                                        if heroId >= 0 and heroId <= 2000
                                           and camp >= 1 and camp <= 2 then
                                            playerList = candidate
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if not rd_isValid(playerList) then
            return nil, nil, "✕  ᴘʟᴀʏᴇʀ ʟɪsᴛ ɴᴏᴛ ꜰᴏᴜɴᴅ — ʀᴜɴ ᴀᴛ ʜᴇʀᴏ sᴇʟᴇᴄᴛ"
        end

        local count    = rd_readI32(playerList + RD_LIST_SIZE)
        local itemsPtr = rd_readPtr(playerList + RD_LIST_ITEMS)
        if count <= 0 or count > 10 or not rd_isValid(itemsPtr) then
            return nil, nil, "✕  ɪɴᴠᴀʟɪᴅ ᴘʟᴀʏᴇʀ ᴄᴏᴜɴᴛ = " .. tostring(count)
        end

        local teamBlue = {}
        local teamRed  = {}

        for i = 0, count - 1 do
            local rdPtr = rd_readPtr(itemsPtr + RD_ARRAY_DATA + i * 8)
            if rd_isValid(rdPtr) then
                local heroId = rd_readI32(rdPtr + RD_HEROID)
                local camp   = rd_readI32(rdPtr + RD_CAMP)
                if heroId >= 0 and heroId <= 2000 and camp >= 1 and camp <= 2 then
                    local uid    = rd_readPtr(rdPtr + RD_UID)
                    local isBot  = (uid >= 0 and uid <= 9)
                    local rank   = rd_readI32(rdPtr + RD_RANK)
                    local myth   = rd_readI32(rdPtr + RD_MYTHPOINT)
                    local elo    = rd_readI32(rdPtr + RD_ELO)
                    local zoneId = rd_readI32(rdPtr + RD_ZONEID)
                    local name   = rd_readStr(rd_readPtr(rdPtr + RD_NAME))
                    if name == "" then name = rd_readStr(rd_readPtr(rdPtr + RD_STEAMNAME)) end
                    if name == "" then name = rd_readStr(rd_readPtr(rdPtr + RD_STEAMSIMPLE)) end
                    local spellId = rd_readI32(rdPtr + RD_SPELLID)
                    local rankStr = rd_rankToString(rank, myth)

                    local player = {
                        uid     = uid,
                        name    = name,
                        heroId  = heroId,
                        spellId = spellId,
                        rank    = rankStr,
                        elo     = elo,
                        zoneId  = zoneId,
                        isBot   = isBot,
                        camp    = camp,
                    }

                    if camp == 1 then
                        teamBlue[#teamBlue+1] = player
                    else
                        teamRed[#teamRed+1] = player
                    end
                end
            end
        end

        return teamBlue, teamRed, nil
    end

    local teamBlue, teamRed, err = fetchRoomData()

    if err then
        gg.toast(err)
        gg.alert(err)
        return
    end

    local totalHumans, totalBots = 0, 0
    for _, p in ipairs(teamBlue) do
        if p.isBot then totalBots = totalBots + 1 else totalHumans = totalHumans + 1 end
    end
    for _, p in ipairs(teamRed) do
        if p.isBot then totalBots = totalBots + 1 else totalHumans = totalHumans + 1 end
    end

    local blueText = rd_buildTeamText(teamBlue, "ᴛᴇᴀᴍ ʙʟᴜᴇ", "🔵", totalHumans, totalBots, 1)
    local redText  = rd_buildTeamText(teamRed,  "ᴛᴇᴀᴍ ʀᴇᴅ",  "🔴", totalHumans, totalBots, #teamBlue + 1)

    local fullText = blueText .. "\n" .. redText
    gg.alert(fullText)

    done("ʀᴏᴏᴍ ɪɴꜰᴏ ʟᴏᴀᴅᴇᴅ")
end

